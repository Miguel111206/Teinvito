# Frontend (Netlify > Site settings > Environment variables). Son públicas por diseño (clave anon).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON

# Solo función keep-alive (NUNCA con prefijo VITE_). Usa la misma URL y clave anon; no necesita service_role.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_CLAVE_ANON
KEEP_ALIVE_ENABLED=true
